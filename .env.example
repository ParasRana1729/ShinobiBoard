# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# --- Auth ---
# Google OAuth is configured in Supabase Dashboard > Authentication > Providers.
# Site URL + redirect: <app-url>/auth/callback
# --- Secrets ---
# HS256 secret for single-use 1:1 duel invites (JWT, 7-day expiry). Generate: openssl rand -base64 32
DUEL_JWT_SECRET=change-me-in-production-min-32-chars
# Shared secret protecting Vercel Cron -> API routes. Send as ?trigger= or Authorization: Bearer
CRON_SECRET=change-me-cron-secret
# --- Tunables (mirror spec §6 / §7.2) ---
# Global default weekly goal (per-group override 1-50). Spec default: 7.
DEFAULT_WEEKLY_GOAL=7
# Sync worker tunables: batch size + concurrency (spec: batch 20, concurrency 5)
SYNC_BATCH_SIZE=20
SYNC_CONCURRENCY=5
